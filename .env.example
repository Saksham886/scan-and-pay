# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cafeorder?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── PhonePe Payment Gateway ─────────────────────────────
# Set PHONEPE_TEST_MODE=true to skip real payments (orders auto-mark as PAID)
PHONEPE_TEST_MODE="true"
# Sandbox (testing): https://api-preprod.phonepe.com/apis/pg-sandbox
# Production:        https://api.phonepe.com/apis/hermes
PHONEPE_BASE_URL="https://api-preprod.phonepe.com/apis/pg-sandbox"
PHONEPE_MERCHANT_ID="PGTESTPAYUAT86"
PHONEPE_SALT_KEY="96434309-7796-489d-8924-ab56988a6076"
PHONEPE_SALT_INDEX="1"

# ─── Razorpay Payment Gateway ────────────────────────────
# Which gateway a cafe uses is chosen per-cafe in the admin panel
# (Payment Gateway settings) and can be switched at any time without a
# redeploy. These are optional global fallback credentials used only if a
# cafe doesn't have its own Razorpay keys configured there.
# Get test-mode keys (prefixed rzp_test_) from
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set when registering the webhook URL in the Razorpay Dashboard
# (Settings > Webhooks > add https://<app>/api/webhooks/razorpay).
# Used to verify inbound webhook signatures. For the QR flow, also enable the
# "qr_code.credited" event on that webhook.
RAZORPAY_WEBHOOK_SECRET=""

# ─── Payment flow (kiosk) ────────────────────────────────
# Selects HOW a Razorpay-provider cafe collects payment. Precedence when more
# than one is set: RAZORPAY_USE_QR > RAZORPAY_USE_PAYMENT_LINKS > Standard
# Checkout (the default). All false/blank = Standard Checkout in a WebView.
#
# Native single-QR flow (recommended for office kiosks): the server mints one
# fixed-amount, single-use UPI QR and the kiosk renders it directly — no
# merchant-confirm screen, no mandatory phone field, no method picker, and no
# QR that regenerates when the customer switches UPI app. Enable this
# per-environment for the pilot rollout.
RAZORPAY_USE_QR="false"
# How long a QR stays payable before it auto-expires (close_by), in minutes.
# Must be >= 2 (Razorpay minimum); 15 is a comfortable default.
RAZORPAY_QR_CLOSE_MINUTES="15"
#
# Escape hatch: Razorpay's own hosted Payment Links page. Use only while a
# Standard Checkout domain registration is pending (Standard Checkout is
# blocked from unregistered domains). Ignored when RAZORPAY_USE_QR=true.
RAZORPAY_USE_PAYMENT_LINKS="false"
#
# The three below apply ONLY to the Standard Checkout WebView flow (i.e. when
# both RAZORPAY_USE_QR and RAZORPAY_USE_PAYMENT_LINKS are false). They have no
# effect on the QR flow, which never shows a contact field.
#   HIDE_CONTACT_FIELDS: hide the phone/email fields entirely. Requires Razorpay
#   Support to first enable "make phone number optional" on the account.
RAZORPAY_HIDE_CONTACT_FIELDS="false"
#   KIOSK_CONTACT / KIOSK_EMAIL: values to prefill and lock on the Checkout page
#   for anonymous kiosk orders, so the customer types nothing. Left blank, the
#   fields simply render empty.
RAZORPAY_KIOSK_CONTACT=""
RAZORPAY_KIOSK_EMAIL=""

# ─── Cloudinary (image uploads) ──────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Redis (SSE fan-out across serverless instances) ─────
# Provision via Vercel Marketplace ("vercel integration add upstash") or
# directly at upstash.com. Use the standard "ioredis"/TCP connection string
# (rediss://...), not the REST URL. Leave empty for local dev — SSE falls
# back to single-process in-memory delivery, which is NOT safe once traffic
# spans multiple serverless instances in production.
REDIS_URL=""

# ─── WhatsApp (order notifications) ──────────────────────
# Leave WHATSAPP_PROVIDER empty to log WhatsApp messages to console (dev mode)
# WHATSAPP_PROVIDER="twilio"          # or "meta"
# Twilio WhatsApp
# TWILIO_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Meta WhatsApp Business Cloud API
# META_WHATSAPP_PHONE_NUMBER_ID=""
# META_WHATSAPP_ACCESS_TOKEN=""
